# Environment variables for AdaptPulse (Endurance Training Planner)

# ==========================================
# 1. Intervals.icu Configuration
# ==========================================
# Obtain your API key in Intervals.icu -> Settings -> API Keys
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
INTERVALS_BASE_URL=https://intervals.icu/api/v1
INTERVALS_PREFIX=adaptpulse-plan-2026

# ==========================================
# 2. TrainingPeaks API Configuration
# ==========================================
# OAuth2 / Bearer Token for TrainingPeaks Partner API
# Base URL defaults to https://api.trainingpeaks.com (or https://api.sandbox.trainingpeaks.com for sandbox testing)
TRAININGPEAKS_ACCESS_TOKEN=
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_ATHLETE_ID=
TRAININGPEAKS_BASE_URL=https://api.trainingpeaks.com

# ==========================================
# 3. OpenRouter API Configuration (Token-Lean & Zero-Cost)
# ==========================================
# API Key for OpenRouter (Strict zero-cost :free models enforced)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
